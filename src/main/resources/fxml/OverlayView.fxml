<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.shape.Circle?>
<?import me.jtrenaud1s.phas.overlay.component.SmudgeTimerPane?>

<!--
  A root Pane, with transparent background,
  containing a SmudgeTimerPane and a Circle (for crosshair).
-->
<Pane fx:id="root"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="me.jtrenaud1s.phas.overlay.view.OverlayView"
      style="-fx-background-color: transparent;">

    <!-- Child nodes -->
    <children>

        <!-- The custom control -->
        <SmudgeTimerPane fx:id="smudgeTimerPane" />

        <!-- A small crosshair dot in the center (visibility controlled in code) -->
        <Circle fx:id="crosshairDot"
                fill="LIMEGREEN"
                radius="3"
                visible="false" />
    </children>
</Pane>